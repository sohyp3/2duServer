HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/2du.sqlite
# Enable only while creating your accounts, then restart with false.
ALLOW_REGISTRATION=false
# Exact browser origins, comma separated. Native clients do not send Origin.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8080,http://127.0.0.1:8080
# Built-in agent (optional). Any OpenAI-compatible API works. Leave all three unset to turn it off.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Voice transcription (optional). Off unless STT_MODEL is set; falls back to the AI_ base URL and key.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
