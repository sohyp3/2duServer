HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/2du.sqlite
# Open sign-up server: anyone who can reach it can create an account. Set false to close it.
ALLOW_REGISTRATION=true
# Set true only behind a local reverse proxy (nginx on the same host) that sets X-Real-IP.
TRUST_PROXY=false
# Optional cap on the number of accounts. Empty means no limit.
MAX_USERS=
# Exact browser origins, comma separated. Native clients do not send Origin.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8080,http://127.0.0.1:8080
